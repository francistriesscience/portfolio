{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "NEXT_PUBLIC_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "build:cloudflare": {
      "dependsOn": ["build"],
      "outputs": [".open-next/**"]
    },
    "preview:cloudflare": {
      "cache": false,
      "persistent": true
    },
    "deploy:cloudflare": {
      "dependsOn": ["build:cloudflare"],
      "cache": false
    },
    "typegen:cloudflare": {
      "outputs": ["cloudflare-env.d.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "worker": {
      "cache": false,
      "persistent": true
    },
    "worker:watch": {
      "cache": false,
      "persistent": true
    },
    "dev:docker:build": {
      "cache": false
    }
  }
}
